# systemd unit for a plain Linux VPS (Hetzner / DigitalOcean / anything).
# sudo cp deploy/focus-agent-bridge.service /etc/systemd/system/
# sudo systemctl enable --now focus-agent-bridge
[Unit]
Description=Focus Agent coach bridge
After=network-online.target

[Service]
User=focus
WorkingDirectory=/opt/focus-agent
EnvironmentFile=/opt/focus-agent/.env      # ANTHROPIC_API_KEY=..., FA_TOKENS=alice:...,bob:...
Environment=FA_HOST=0.0.0.0
Environment=PORT=8000
ExecStart=/usr/bin/python3 bridge/coach_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
